        await message.answer("❌ Промокод не найден")
        return
    if promo["used_count"] >= promo["max_uses"]:
        await message.answer("❌ Лимит исчерпан")
        return
    if await promo_was_used(code, uid):
        await message.answer("❌ Вы уже использовали этот промокод")
        return

    if not await log_promo_use(code, uid, "promo",
                                promo["days"] or promo["stars"] or promo.get("spins", 0)):
        await message.answer("❌ Вы уже использовали этот промокод")
        return

    await promo_inc_used(code)

