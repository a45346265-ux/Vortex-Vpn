async def get_users_to_remind_spin(hours_ahead: int = 1):
    cooldown = SPIN_FREE_COOLDOWN_DAYS * 24 * 3600
    threshold = cooldown - hours_ahead * 3600
    async with _db_conn.execute("""
        SELECT user_id, last_free_spin FROM spin_cooldown
        WHERE last_free_spin IS NOT NULL
          AND (spin_reminded_at IS NULL OR spin_reminded_at = '')
    """) as cur:
        rows = [dict(r) async for r in cur]
    result = []
    now = datetime.now()
    for r in rows:
        try:
            last = datetime.strptime(r["last_free_spin"], "%Y-%m-%d %H:%M:%S")
        except Exception:
            continue
        if (now - last).total_seconds() >= threshold:
            result.append(r["user_id"])
    return result


