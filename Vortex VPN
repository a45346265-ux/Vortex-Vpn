_db_conn: aiosqlite.Connection | None = None


async def db_init():
    global _db_conn
    _db_conn = await aiosqlite.connect(DB_NAME)
    _db_conn.row_factory = aiosqlite.Row
    await _db_conn.execute("PRAGMA journal_mode=WAL")
    await _db_conn.executescript("""
        CREATE TABLE IF NOT EXISTS keys (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            tariff TEXT NOT NULL,
            key_value TEXT NOT NULL UNIQUE,
            is_used INTEGER DEFAULT 0,
            used_by_id INTEGER,
            used_by_username TEXT,
            used_at TEXT,
            expire_date TEXT,
            reminded_at TEXT
        );
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            username TEXT,
            referrer_id INTEGER,
            bonus_days INTEGER DEFAULT 0,
            stars_balance INTEGER DEFAULT 0,
            got_trial INTEGER DEFAULT 0,
            created_at TEXT
        );
        CREATE TABLE IF NOT EXISTS sales (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            tariff TEXT,
            amount_stars INTEGER,
            created_at TEXT
        );
        CREATE TABLE IF NOT EXISTS promo_codes (
            code TEXT PRIMARY KEY,
            days INTEGER DEFAULT 0,
            stars INTEGER DEFAULT 0,
            spins INTEGER DEFAULT 0,
            max_uses INTEGER DEFAULT 1,
            used_count INTEGER DEFAULT 0,
            is_active INTEGER DEFAULT 1,
            created_by INTEGER,
            created_at TEXT
        );
        CREATE TABLE IF NOT EXISTS promo_uses (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            code TEXT,
            user_id INTEGER,
            kind TEXT,
            value INTEGER,
            used_at TEXT,
            UNIQUE(code, user_id, kind)
        );
        CREATE TABLE IF NOT EXISTS spin_cooldown (
            user_id INTEGER PRIMARY KEY,
            last_free_spin TEXT,
            spins_available INTEGER DEFAULT 0,
            spin_reminded_at TEXT,
            total_spins INTEGER DEFAULT 0,
            total_won_stars INTEGER DEFAULT 0,
            total_won_days INTEGER DEFAULT 0
        );
        CREATE TABLE IF NOT EXISTS spin_history (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            prize_type TEXT NOT NULL,
            value INTEGER NOT NULL,
            is_free INTEGER NOT NULL,
            created_at TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS user_discounts (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            percent INTEGER NOT NULL,
            source TEXT NOT NULL,
            place INTEGER NOT NULL,
            expires_at TEXT NOT NULL,
            used_at TEXT,
            created_at TEXT NOT NULL
        );
        CREATE INDEX IF NOT EXISTS idx_keys_used_by ON keys(used_by_id, is_used);
        CREATE INDEX IF NOT EXISTS idx_keys_tariff_free ON keys(tariff, is_used);
        CREATE INDEX IF NOT EXISTS idx_users_ref ON users(referrer_id);
        CREATE INDEX IF NOT EXISTS idx_spin_hist_user ON spin_history(user_id, created_at);
        CREATE INDEX IF NOT EXISTS idx_discounts ON user_discounts(user_id, used_at);
    """)
    await _db_conn.commit()

    # ─── Миграции для старых БД ───
    migrations = [
        ("keys", "reminded_at", "TEXT"),
        ("users", "stars_balance", "INTEGER DEFAULT 0"),
        ("promo_codes", "spins", "INTEGER DEFAULT 0"),
        ("spin_cooldown", "spins_available", "INTEGER DEFAULT 0"),
        ("spin_cooldown", "spin_reminded_at", "TEXT"),
    ]
    for table, col, typedef in migrations:
        async with _db_conn.execute(f"PRAGMA table_info({table})") as cur:
            cols = [r[1] async for r in cur]
        if col not in cols:
            try:
                await _db_conn.execute(f"ALTER TABLE {table} ADD COLUMN {col} {typedef}")
            except Exception as e:
                logger.warning(f"Migration {table}.{col}: {e}")
    await _db_conn.commit()
    logger.info("БД готова")


