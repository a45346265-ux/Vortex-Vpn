async def animate_spin(msg, final_prize_text: str):
    faces = ["1 ⭐", "3 ⭐", "😢", "5 ⭐", "10 ⭐", "1 д", "15 ⭐", "3 ⭐", "25 ⭐", "😢"]
    offset = 0
    delays = [0.15, 0.15, 0.15, 0.2, 0.2, 0.25, 0.3, 0.35, 0.4, 0.5]

    for i, delay in enumerate(delays):
        window = [faces[(offset + j) % len(faces)] for j in range(4)]
        offset += 1
        top_arrow = "▼" if i % 2 == 0 else "▲"
        bot_arrow = "▲" if i % 2 == 0 else "▼"
        text = (
            f"🎰 <b>Крутим...</b>\n"
            f"🎯 {top_arrow}\n"
            f"┃ {window[0]} ┃ {window[1]} ┃ {window[2]} ┃ {window[3]} ┃\n"
            f"   {bot_arrow}\n"
            f"🎯 {'▼' if i % 2 == 0 else '▲'}"
        )
        try:
            await msg.edit_text(text, parse_mode="HTML")
        except Exception:
            pass
        await asyncio.sleep(delay)

    try:
        await msg.edit_text(final_prize_text, parse_mode="HTML")
    except Exception:
        pass


