def spin_wheel():
    total = sum(w for _, _, w in SPIN_PRIZES)
    r = random.uniform(0, total)
    upto = 0
    for prize_type, value, weight in SPIN_PRIZES:
        if upto + weight >= r:
            return prize_type, value
        upto += weight
    return "empty", 0


def fmt_seconds(seconds: int) -> str:
    if seconds < 60:
        return f"{seconds} сек"
    if seconds < 3600:
        return f"{seconds // 60} мин"
    if seconds < 86400:
        h = seconds // 3600
        m = (seconds % 3600) // 60
        return f"{h} ч {m} мин"
    d = seconds // 86400
    h = (seconds % 86400) // 3600
    return f"{d} д {h} ч"


