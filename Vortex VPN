async def extend_user_key(uid, days):
    async with _db_conn.execute(
        "SELECT id, expire_date FROM keys WHERE used_by_id=? AND is_used=1 ORDER BY used_at DESC LIMIT 1",
        (uid,)
    ) as cur:
        row = await cur.fetchone()
    if not row:
        return None
    key_id, old_expire = row["id"], row["expire_date"]
    try:
        old_dt = datetime.strptime(old_expire, "%d.%m.%Y")
    except Exception:
        old_dt = datetime.now()
    new_dt = (old_dt if old_dt > datetime.now() else datetime.now()) + timedelta(days=days)
    new_expire = new_dt.strftime("%d.%m.%Y")
    await _db_conn.execute("UPDATE keys SET expire_date=?, reminded_at=NULL WHERE id=?",
                           (new_expire, key_id))
    await _db_conn.commit()
    return new_expire


