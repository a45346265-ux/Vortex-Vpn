async def spin_weekly_task():
    if not SPIN_LEADERBOARD_ENABLED:
        return
    await asyncio.sleep(90)
    now = datetime.utcnow()
    days_ahead = (7 - now.weekday()) % 7
    if days_ahead == 0 and (now.hour > 0 or now.minute > 0):
        days_ahead = 7
    next_monday = (now + timedelta(days=days_ahead)).replace(
        hour=0, minute=0, second=0, microsecond=0)
    wait_seconds = (next_monday - now).total_seconds()
    logger.info(f"Spin weekly: следующий запуск через {wait_seconds/3600:.1f} ч")
    await asyncio.sleep(wait_seconds)
    while True:
        try:
            await run_spin_weekly_award()
        except Exception as e:
            logger.error(f"spin_weekly: {e}")
        await asyncio.sleep(7 * 24 * 60 * 60)


