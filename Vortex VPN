async def get_spin_leaderboard(limit: int = 10, days: int = 7):
    cutoff = (datetime.now() - timedelta(days=days)).strftime("%Y-%m-%d %H:%M:%S")
    async with _db_conn.execute("""
        SELECT user_id,
               COUNT(*) AS spins_count,
               COALESCE(SUM(CASE WHEN prize_type='star' THEN value ELSE 0 END), 0) AS total_stars,
               COALESCE(SUM(CASE WHEN prize_type='day' THEN value ELSE 0 END), 0) AS total_days
        FROM spin_history
        WHERE created_at >= ?
        GROUP BY user_id
        HAVING spins_count > 0
        ORDER BY total_stars DESC, spins_count DESC
        LIMIT ?
    """, (cutoff, limit)) as cur:
        return [dict(r) async for r in cur]


async def get_user_spin_rank(uid, days: int = 7):
    cutoff = (datetime.now() - timedelta(days=days)).strftime("%Y-%m-%d %H:%M:%S")
    async with _db_conn.execute("""
        SELECT COUNT(*) AS spins_count,
               COALESCE(SUM(CASE WHEN prize_type='star' THEN value ELSE 0 END), 0) AS total_stars,
               COALESCE(SUM(CASE WHEN prize_type='day' THEN value ELSE 0 END), 0) AS total_days
        FROM spin_history WHERE user_id = ? AND created_at >= ?
    """, (uid, cutoff)) as cur:
        row = await cur.fetchone()
    if not row or row["spins_count"] == 0:
        return None
    async with _db_conn.execute("""
        SELECT COUNT(*) AS rank FROM (
            SELECT user_id,
                   COALESCE(SUM(CASE WHEN prize_type='star' THEN value ELSE 0 END), 0) AS total_stars,
                   COUNT(*) AS spins_count
            FROM spin_history WHERE created_at >= ?
            GROUP BY user_id
        )
        WHERE total_stars > ? OR (total_stars = ? AND spins_count > ?)
    """, (cutoff, row["total_stars"], row["total_stars"], row["spins_count"])) as cur:
        rank_row = await cur.fetchone()
    return {
        "rank": (rank_row["rank"] or 0) + 1,
        "spins_count": row["spins_count"],
        "total_stars": row["total_stars"],
        "total_days": row["total_days"],
    }


