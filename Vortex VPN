@dp.message(Command("addpromo"))
async def cmd_addpromo(message: types.Message):
    if not is_admin(message):
        return
    args = message.text.split()
    if len(args) < 5:
        await message.answer(
            "📝 <b>Создание промокода</b>\n\n"
            "<b>Формат:</b> <code>/addpromo КОД ДНИ ЗВЁЗДЫ СПИНЫ [ЛИМИТ]</code>\n\n"
            "<b>Примеры:</b>\n"
            "<code>/addpromo SUMMER 5 15 0 100</code>\n"
            "<code>/addpromo SPIN5 0 0 5 50</code>\n"
            "<code>/addpromo MEGA 30 50 10 5</code>",
            parse_mode="HTML")
        return
    code = args[1].upper().strip()
    if not code.isalnum() or len(code) > 20:
        await message.answer("❌ Код: буквы/цифры, до 20")
        return
    try:
        days = int(args[2])
        stars = int(args[3])
        spins = int(args[4])
        limit = int(args[5]) if len(args) > 5 else 100
    except ValueError:
        await message.answer("❌ Числа в полях")
        return
    if days < 0 or stars < 0 or spins < 0:
        await message.answer("❌ Отрицательные нельзя")
        return
    if days == 0 and stars == 0 and spins == 0:
        await message.answer("❌ Хоть что-то должно быть")
        return
    if limit < 1 or limit > 10000:
        await message.answer("❌ Лимит: 1-10000")
        return
    ok = await create_promo(code, days, stars, limit, message.from_user.id, spins=spins)
    if not ok:
        await message.answer(f"❌ Промокод <b>{code}</b> уже существует", parse_mode="HTML")
        return
    parts = []
    if days > 0: parts.append(f"🎁 +{days}д")
    if stars > 0: parts.append(f"⭐ +{stars}⭐")
    if spins > 0: parts.append(f"🎰 +{spins} спинов")
    await message.answer(
        f"✅ <b>Промокод создан!</b>\n\n"
        f"🔑 <code>{code}</code>\n"
        f"📦 {' + '.join(parts)}\n"
        f"🔢 Лимит: <b>{limit}</b>",
