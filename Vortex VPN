async def can_free_spin(uid) -> tuple[bool, int, bool]:
    bonus_spins = await get_free_spins(uid)
    if bonus_spins > 0:
        return True, 0, True
    cd = await get_spin_cooldown(uid)
    if not cd or not cd["last_free_spin"]:
        return True, 0, False
    try:
        last = datetime.strptime(cd["last_free_spin"], "%Y-%m-%d %H:%M:%S")
    except Exception:
        return True, 0, False
    delta = (datetime.now() - last).total_seconds()
    cooldown = SPIN_FREE_COOLDOWN_DAYS * 24 * 3600
    if delta >= cooldown:
        return True, 0, False
    return False, int(cooldown - delta), False


async def record_spin(uid, prize_type, value, is_free):
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    await _db_conn.execute(
        "INSERT INTO spin_history (user_id, prize_type, value, is_free, created_at) "
        "VALUES (?,?,?,?,?)", (uid, prize_type, value, int(is_free), now))
    await _db_conn.execute(
        "UPDATE spin_cooldown SET spin_reminded_at = NULL WHERE user_id = ?", (uid,))

    stars_add = value if prize_type == "star" else 0
    days_add = value if prize_type == "day" else 0

    async with _db_conn.execute(
        "SELECT user_id FROM spin_cooldown WHERE user_id=?", (uid,)
    ) as cur:
        exists = await cur.fetchone()

    if exists:
        if is_free:
            await _db_conn.execute(
                "UPDATE spin_cooldown SET last_free_spin=?, "
                "total_spins=total_spins+1, total_won_stars=total_won_stars+?, "
                "total_won_days=total_won_days+? WHERE user_id=?",
                (now, stars_add, days_add, uid))
        else:
            await _db_conn.execute(
                "UPDATE spin_cooldown SET total_spins=total_spins+1, "
                "total_won_stars=total_won_stars+?, total_won_days=total_won_days+? "
                "WHERE user_id=?", (stars_add, days_add, uid))
    else:
        await _db_conn.execute(
            "INSERT INTO spin_cooldown (user_id, last_free_spin, total_spins, "
            "total_won_stars, total_won_days) VALUES (?,?,?,?,?)",
            (uid, now if is_free else None, 1, stars_add, days_add))
    await _db_conn.commit()


